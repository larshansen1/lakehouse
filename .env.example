# Copy this file to `.env` and adjust values as needed.
# Credentials should be rotated for real deployments.

MINIO_ROOT_USER=ducklake
MINIO_ROOT_PASSWORD=ducklake-insecure-change-me
MINIO_BUCKET_NAME=lake

# Ports exposed by docker compose
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Convenience endpoints for local clients
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_CONSOLE_URL=http://localhost:9001

# DuckLake catalog backend (duckdb | postgres)
DUCKLAKE_BACKEND=duckdb

# DuckDB catalog (only used when DUCKLAKE_BACKEND=duckdb)
# Update DUCKLAKE_DATA_PATH whenever MINIO_BUCKET_NAME changes.
DUCKLAKE_METADATA_PATH=ducklake/catalog.duckdb
DUCKLAKE_DATA_PATH=s3://lake/ducklake

# Postgres catalog (only used when DUCKLAKE_BACKEND=postgres)
DUCKLAKE_PG_HOST=127.0.0.1
DUCKLAKE_PG_PORT=55432
DUCKLAKE_PG_DB=ducklake
DUCKLAKE_PG_USER=ducklake
DUCKLAKE_PG_PASSWORD=ducklake-insecure-change-me
DUCKLAKE_PG_SSLMODE=disable
